<!--
  Settings every project in the repository shares. Imported before each project file, so a project
  that needs something different can still override it - Player.Vm.Api.Client pins LangVersion 8.0
  for its netstandard2.0 target, and that wins over the value here.
-->
<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>

    <!--
      A warning that nobody has to act on is a warning nobody reads, and the compiler and the xUnit
      analyzers report real defects: an unawaited task, a [Theory] with no data, an assertion that
      cannot fail, an awaited call that does not take the test's cancellation token. The build is
      clean today - one xUnit1051 was fixed when this was introduced, and there was nothing else - so
      this keeps it that way rather than paying off a backlog.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      Restore-time warnings stay warnings. NU1901-NU1904 are the NuGet audit, and it has findings
      here that a build failure would only make invisible by blocking every build:

      - AutoMapper 13 is the one direct hit. It is pinned deliberately, because the fix is in
        15.1.1 and version 15+ requires a commercial license. MediatR 12 is pinned for the same
        reason.
      - Microsoft.NETCore.App 2.1.0 arrives through VimClient's dotnet-svcutil.xmlserializer. It is
        the .NET Core 2.1 framework package, so it cannot be raised to a fixed version on net10.0,
        and the net10.0 shared framework is what the API runs on.

      The other transitive hits are raised by the security pins in Directory.Packages.props. Check
      where it stands with `dotnet list package` and its vulnerable and transitive switches when
      bumping a dependency; docs/Testing.md spells out the command.
    -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
