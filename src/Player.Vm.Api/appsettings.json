{
  "PathBase": "",
  "Logging": {
    "IncludeScopes": false,
    "Debug": {
      "LogLevel": {
        "Default": "Warning"
      }
    },
    "Console": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  },
  "ClientSettings": {
    "urls": {
      "playerApi": "http://localhost:4300/"
    }
  },
  "CorsPolicy": {
    "Origins": ["http://localhost:4303", "http://localhost:4305"],
    "Methods": [],
    "Headers": [],
    "AllowAnyOrigin": false,
    "AllowAnyMethod": true,
    "AllowAnyHeader": true,
    "SupportsCredentials": true
  },
  "ConnectionStrings": {
    "PostgreSQL": "Server=localhost;Port=5432;Database=player_vm;Username=postgres;Password=password;",
    "Sqlite": "Data Source=player_vm.db",
    "SqlServer": "Server=(localdb)\\mssqllocaldb;Database=player_vm;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Database": {
    "AutoMigrate": true,
    "DevModeRecreate": false,
    "Provider": "Sqlite"
    /*  Options:
        "InMemory", "Sqlite", "SqlServer", "PostgreSQL"   */
  },
  "Authorization": {
    "Authority": "http://localhost:5000",
    "AuthorizationUrl": "http://localhost:5000/connect/authorize",
    "TokenUrl": "http://localhost:5000/connect/token",
    "AuthorizationScope": "player player-vm",
    "PrivilegedScope": "player-vm-privileged",
    "ClientId": "player.vm.swagger",
    "ClientName": "Player VM Swagger UI",
    "ClientSecret": "",
    "RequireHttpsMetadata": false,
    "ValidateAudience": true,
    "ValidAudiences": [] // Defaults to AuthorizationScope + PrivilegedScope if null or empty
  },
  // The shared ISO upload pipeline. Where the bytes end up is per-provider: see Vsphere:IsoUploadViaApi /
  // Vsphere:IsoRoot and Proxmox:IsoUploadViaApi / Proxmox:IsoRoot.
  "IsoUpload": {
    "MaxFileSize": 6000000000,
    "TempStagingPath": "",
    "UploadTimeoutMinutes": 60
  },
  "Vsphere": {
    "IsoUploadViaApi": false, // true = upload to each vCenter's datastore over its HTTP file API, landing at "[DsName] BaseFolder/{viewId}/{scopeId}/{file}" on every enabled host; false = write to IsoRoot
    "IsoRoot": "player/isos", // Local path to write uploaded isos to when IsoUploadViaApi is false. Must be a share (typically NFS) mounted on the hypervisor hosts that surfaces at exactly "[DsName] BaseFolder" - listing browses the datastore in both modes
    "ConnectionRetryIntervalSeconds": 60,
    "ConnectionRefreshIntervalMinutes": 20,
    "ConnectionTimeoutSeconds": 90,
    "LoadCacheAfterMinutes": 5,
    "LogConsoleAccess": false,
    "CheckTaskProgressIntervalMilliseconds": 5000,
    "ReCheckTaskProgressIntervalMilliseconds": 1000,
    "HealthAllowanceSeconds": 180,
    "SkipGuestFileCertificateValidation": false,
    "GuestFileTransferTimeoutMinutes": 3,
    "TaskTimeoutMinutes": 10,
    "TaskInfoUnavailableTimeoutSeconds": 30,
    "TaskPollIntervalMilliseconds": 1000, // How often to poll a vCenter task or guest process that an in-flight request is waiting on, as opposed to the background poller above
    "GuestProcessTempPath": "",
    "GuestProcessDefaultTimeoutSeconds": 300,
    "Hosts": [
      {
        "Enabled": true,
        "Address": "",
        "Username": "",
        "Password": "",
        "DsName": "",
        "BaseFolder": "player"
      }
    ]
  },
  "RewriteHost": {
    "RewriteHost": false,
    "RewriteHostUrl": "localhost:4304",
    "RewriteHostQueryParam": "vm-host"
  },
  "IdentityClient": {
    "TokenUrl": "http://localhost:5000/connect/token",
    "ClientId": "player-vm-admin",
    "Scope": "player player-vm",
    "UserName": "",
    "Password": "",
    "MaxRetryDelaySeconds": 120,
    "TokenRefreshSeconds": 600
  },
  "ConsoleUrls": {
    "DefaultUrl": "http://localhost:4305",
    "Vsphere": {
      "Url": ""
    },
    "Guacamole": {
      "ProviderName": "crucible"
    },
    "Proxmox": {
      "Url": ""
    }
  },
  "VmUsageLogging": {
    "Enabled": false,
    "PostgreSQL": "Server=localhost;Port=5432;Database=vm_logging;Username=postgres;Password=password;"
  },
  "Proxmox": {
    "Enabled": false,
    "Host": "",
    "Port": 8006, // Default Proxmox port. Change to 443 if going through a reverse proxy
    "Token": "",
    "ValidateCertificate": true, // Turn off where PVE serves its stock self-signed certificate rather than one from a trusted CA
    "StateRefreshIntervalSeconds": 5, // How often to reconcile Vm power state from cluster resources
    "CheckTaskProgressIntervalMilliseconds": 5000, // How often to poll cluster tasks while nothing is pending
    "ReCheckTaskProgressIntervalMilliseconds": 1000, // How often to poll while a task is still running
    "FileUploadMaxBytes": 61440, // Max UploadFileToGuest payload; kept under the QEMU guest agent's ~64 KiB file-write limit
    "GuestProcessPollMs": 500, // Interval between guest-agent exec-status polls while waiting for RunGuestProcess to finish
    "GuestProcessDefaultTimeoutSeconds": 300,
    // View/team-scoped ISO storage. Set IsoStorage to turn Proxmox ISO support on; clear it to turn it off.
    "IsoStorage": "", // PVE storage id holding View/team ISOs; required in both write modes
    "IsoUploadViaApi": false, // true = upload through PVE's storage upload API; false = write to IsoRoot
    "IsoRoot": "player/isos", // Local path to write uploaded isos to when IsoUploadViaApi is false. Must be a mount of IsoStorage's own template/iso directory (typically its NFS export) - PVE fixes that layout, so unlike Vsphere:IsoRoot this is not an arbitrary path within a share
    "IsoScopeSeparator": "__" // Folded into filenames to carry scope, since Proxmox ISO storage is flat. Must consist of [-a-zA-Z0-9_.] or PVE's upload API will rewrite it
  },
  "SignalR": {
    "EnableStatefulReconnect": true,
    "StatefulReconnectBufferSizeBytes": 100000
  },
  "OpenTelemetry": {
    "AddAlwaysOnTracingSampler": false,
    "AddConsoleExporter": false,
    "AddPrometheusExporter": false,
    "IncludeDefaultActivitySources": true,
    "IncludeDefaultMeters": true
  },
  "HealthChecksUI": {
    "Enabled": true,
    "Path": "/api/healthchecks-ui",
    "HealthChecks": [
      {
        "Name": "Live",
        "Uri": "/api/health/live"
      },
      {
        "Name": "Ready",
        "Uri": "/api/health/ready"
      }
    ],
    "EvaluationTimeinSeconds": 30,
    "MinimumSecondsBetweenFailureNotifications": 60
  }
}
