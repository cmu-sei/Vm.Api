<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- As the application projects have them: implicit usings off, nullable off. -->
    <Nullable>disable</Nullable>
    <!-- Required by xUnit v3: the test project is a self-executing host. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Player.Vm.Api.Tests</RootNamespace>

    <!--
      Applies coverlet.runsettings to every run, so a coverage run cannot go without its exclusions. The
      collector in that file is disabled by default, so an ordinary `dotnet test` collects nothing.
    -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)/coverlet.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="NSubstitute" />
    <!-- The shared harness in Support/Shared (agent-docs/api-testing). -->
    <Using Include="Crucible.Api.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" />
    <!-- Hosts Player.Vm.Api in process over TestServer, so the tests drive the real Startup. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- An app extra: connects to the hosted hubs over the real SignalR protocol (HubConnectionTests), so
         the group names the hubs join and the ones the application broadcasts to are proved to agree on a
         live connection. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests run on the ASP.NET Core shared framework already, because Mvc.Testing brings it, but
         restore only prunes the packages a framework ships for frameworks the project names itself.
         Naming it drops System.Security.Cryptography.Xml 5.0.0, and the System.Drawing.Common 5.0.0
         under it, from VimClient's WCF packages, as it does in Player.Vm.Api; both are NuGet audit hits. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Player.Vm.Api\Player.Vm.Api.csproj" />
  </ItemGroup>

</Project>
