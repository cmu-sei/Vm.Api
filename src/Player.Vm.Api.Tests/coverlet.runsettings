<?xml version="1.0" encoding="utf-8" ?>
<!--
  Shared by every Crucible API test project (agent-docs/api-testing). Copied byte for byte next to the
  test .csproj, which names it in RunSettingsFilePath; do not edit in a repo.

  Scopes coverage to code the repository writes and could plausibly test. Without it the figure is
  dominated by things no test drives: in player.api the generated migration assembly took the total from
  14,368 sequence points to 36,661 and scored 96.9%, purely because the harness calls Migrate() on a real
  database, which put the headline at 94.6% while the API itself sat at 86.2%.

  The collector is disabled by default, so an ordinary `dotnet test` pays nothing for coverage it did not
  ask for; collecting is opt-in through the collect argument of `dotnet test` ("XPlat Code Coverage"),
  and the exclusions below still apply.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage" enabled="False">
        <Configuration>
          <Format>cobertura</Format>

          <!--
            Assembly-level exclusions. Migrations are generated by `dotnet ef migrations add`; asserting
            on them pins EF's output, not the application's behaviour. The test assembly excludes itself.
          -->
          <Exclude>[*.Migrations.PostgreSQL]*,[*.Tests]*</Exclude>

          <!--
            File-level exclusions, for code that compiles into the application's assemblies:
            - Crucible.Common.EntityEvents ships its implementation as contentFiles, so it compiles into
              the data assembly and no assembly filter can reach it.
            - Migrations that live inside the API or data assembly (caster.api, vm.api), and any added to
              another assembly later.
          -->
          <ExcludeByFile>**/.nuget/packages/**/*.cs,**/Migrations/**/*.cs</ExcludeByFile>

          <!-- Generated code, by attribute, wherever source generators and the compiler put it. -->
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute,Obsolete</ExcludeByAttribute>

          <!-- Auto-implemented property accessors are not logic and cannot fail. -->
          <SkipAutoProps>true</SkipAutoProps>

          <IncludeTestAssembly>false</IncludeTestAssembly>
          <UseSourceLink>false</UseSourceLink>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
