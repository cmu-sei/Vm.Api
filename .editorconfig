# Analyzer configuration. Code style is deliberately not legislated here: the API was written with
# block-scoped namespaces and the test project with file-scoped ones, and encoding one of them would
# turn every file into a diff without making anything more correct.
#
# What this file does is raise the analyzer rules that ship as suggestions and that the test suite's
# own conventions depend on. Directory.Build.props turns warnings into errors, so anything named here
# fails the build.
root = true

[*.cs]

# A skipped test reports nothing. A defect found while testing is characterized by a passing test of the
# current behaviour, never parked with Skip (agent-docs/api-testing). Runtime conditional skips
# (Assert.SkipWhen, SkipUnless) are unaffected.
dotnet_diagnostic.xUnit1004.severity = warning
